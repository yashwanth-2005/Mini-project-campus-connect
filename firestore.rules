/**
 * @file Firestore Security Rules for CampusConnect
 * @description This ruleset enforces a user-ownership model for user profiles and author-based control for announcements, forum posts and resources, while events and chatbot messages are publicly readable.
 *
 * Data Structure:
 * - /users/{userId}: Stores private user profile data, accessible only to the user.
 * - /announcements/{announcementId}: Stores announcements, write-controlled by the authorId field.
 * - /events/{eventId}: Stores event information, publicly readable.
 * - /forum_posts/{forumPostId}: Stores forum posts, write-controlled by the authorId field.
 * - /resources/{resourceId}: Stores resources, write-controlled by the uploaderId field.
 * - /chat_messages/{chatMessageId}: Stores chatbot messages, publicly readable.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Announcements, Forum Posts, and Resources are author-controlled.
 * - Events and Chatbot messages are publicly readable.
 * - Listing of user profiles is disallowed for privacy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data. Only the user can read and write their own profile.
     * @path /users/{userId}
     * @allow (create, update, delete) if request.auth.uid == userId
     * @deny (create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Only the authenticated user can read their own profile.
      allow get: if isSignedIn() && isOwner(userId);
      // No one can list all user profiles.
      allow list: if false;

      // Only the authenticated user can create their own profile.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;

      // Only the authenticated user can update their own profile.
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Only the authenticated user can delete their own profile.
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to announcements. Anyone can read, but only the author can create, update, or delete.
     * @path /announcements/{announcementId}
     * @allow (get, list) if true
     * @allow (create) if request.auth.uid == request.resource.data.authorId
     * @allow (update, delete) if request.auth.uid == resource.data.authorId
     * @deny (create, update, delete) if request.auth.uid != resource.data.authorId
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /announcements/{announcementId} {
      // Allow anyone to read announcements.
      allow get, list: if true;

      // Only the author can create an announcement, and authorId must match the request.auth.uid.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;

      // Only the author can update an announcement.
      allow update: if isSignedIn() && isExistingOwner(resource.data.authorId);

      // Only the author can delete an announcement.
      allow delete: if isSignedIn() && isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Controls access to events. All users can read the event data.
     * @path /events/{eventId}
     * @allow get, list: if true
     * @principle Allows public reads.
     */
    match /events/{eventId} {
      // Allow anyone to read events.
      allow get, list: if true;

      // Anyone can create, update, and delete events (Public Read with Owner-Only Writes pattern requires an ownership field.)
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to forum posts. Anyone can read, but only the author can create, update, or delete.
     * @path /forum_posts/{forumPostId}
     * @allow (get, list) if true
     * @allow (create) if request.auth.uid == request.resource.data.authorId
     * @allow (update, delete) if request.auth.uid == resource.data.authorId
     * @deny (create, update, delete) if request.auth.uid != resource.data.authorId
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /forum_posts/{forumPostId} {
      // Allow anyone to read forum posts.
      allow get, list: if true;

      // Only the author can create a forum post, and authorId must match the request.auth.uid.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;

      // Only the author can update a forum post.
      allow update: if isSignedIn() && isExistingOwner(resource.data.authorId);

      // Only the author can delete a forum post.
      allow delete: if isSignedIn() && isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Controls access to resources. Anyone can read, but only the uploader can create, update, or delete.
     * @path /resources/{resourceId}
     * @allow (get, list) if true
     * @allow (create) if request.auth.uid == request.resource.data.uploaderId
     * @allow (update, delete) if request.auth.uid == resource.data.uploaderId
     * @deny (create, update, delete) if request.auth.uid != resource.data.uploaderId
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /resources/{resourceId} {
      // Allow anyone to read resources.
      allow get, list: if true;

      // Only the uploader can create a resource, and uploaderId must match the request.auth.uid.
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;

      // Only the uploader can update a resource.
      allow update: if isSignedIn() && isExistingOwner(resource.data.uploaderId);

      // Only the uploader can delete a resource.
      allow delete: if isSignedIn() && isExistingOwner(resource.data.uploaderId);
    }

    /**
     * @description Controls access to chat messages. All users can read the chat messages.
     * @path /chat_messages/{chatMessageId}
     * @allow get, list: if true
     * @principle Allows public reads.
     */
    match /chat_messages/{chatMessageId} {
      // Allow anyone to read chat messages.
      allow get, list: if true;

        // Anyone can create, update, and delete chat messages (Public Read with Owner-Only Writes pattern requires an ownership field.)
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the resource.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    // Helper function to determine if the user is the existing owner of the resource.
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}