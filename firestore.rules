/**
 * @file Firestore Security Rules for CampusConnect
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and allows public read access with owner-only writes for announcements, events, forum posts, resources, and chat messages.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data; access is restricted to the owning user.
 * - /announcements/{announcementId}: Stores announcement data; public read, owner-only write.
 * - /events/{eventId}: Stores event data; public read, owner-only write.
 * - /forum_posts/{forumPostId}: Stores forum posts; public read, owner-only write.
 * - /resources/{resourceId}: Stores resource data; public read, owner-only write.
 * - /chat_messages/{chatMessageId}: Stores chat messages; public read, owner-only write.
 *
 * Key Security Decisions:
 * - User listing is disabled to protect privacy.
 * - Public read access is granted to top-level collections to facilitate data sharing and discovery.
 * - Write access to top-level collections is restricted to the owner (creator) of the document, enforced by matching `authorId` or `uploaderId` to the authenticated user's ID.
 * - Data validation is minimized in this prototyping phase to allow for rapid schema iteration.
 *
 * Denormalization for Authorization:
 * - Announcements, events, forum posts, resources, and chat messages include an `authorId` or `uploaderId` field to simplify ownership checks without requiring additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Controls access to user profile data. Only the user can read or write their own profile.
     * @path: /users/{userId}
     * @allow: User with UID 'user123' (create, update, get, list) if they are accessing their own profile (userId == 'user123').
     * @deny: User with UID 'user456' (create, update, get, list) if they try to access profile 'user123'.
     * @principle: Enforces strict user-ownership for profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description: Controls access to announcements. Allows public read access, but restricts write access to the announcement's author.
     * @path: /announcements/{announcementId}
     * @allow: Any user (get, list). User with UID 'user123' (create, update, delete) if they are the author of the announcement (authorId == 'user123').
     * @deny: User with UID 'user456' (create, update, delete) if they try to modify an announcement authored by 'user123'.
     * @principle: Public read, owner-only write. Validates author on create, update, and delete.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && request.resource.data.authorId == request.auth.uid;
    }

    /**
     * @description: Controls access to events. Allows public read access, but restricts write access to the event's creator.
     * @path: /events/{eventId}
     * @allow: Any user (get, list). User with UID 'user123' (create, update, delete) if they are the author of the event (authorId == 'user123').
     * @deny: User with UID 'user456' (create, update, delete) if they try to modify an event authored by 'user123'.
     * @principle: Public read, owner-only write. Validates author on create, update, and delete.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && request.resource.data.authorId == request.auth.uid;
    }

    /**
     * @description: Controls access to forum posts. Allows public read access, but restricts write access to the post's author.
     * @path: /forum_posts/{forumPostId}
     * @allow: Any user (get, list). User with UID 'user123' (create, update, delete) if they are the author of the post (authorId == 'user123').
     * @deny: User with UID 'user456' (create, update, delete) if they try to modify a post authored by 'user123'.
     * @principle: Public read, owner-only write. Validates author on create, update, and delete.
     */
    match /forum_posts/{forumPostId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && request.resource.data.authorId == request.auth.uid;
    }

    /**
     * @description: Controls access to resources. Allows public read access, but restricts write access to the uploader.
     * @path: /resources/{resourceId}
     * @allow: Any user (get, list). User with UID 'user123' (create, update, delete) if they are the uploader of the resource (uploaderId == 'user123').
     * @deny: User with UID 'user456' (create, update, delete) if they try to modify a resource uploaded by 'user123'.
     * @principle: Public read, owner-only write. Validates uploader on create, update, and delete.
     */
    match /resources/{resourceId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.uploaderId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.uploaderId == request.auth.uid;
      allow delete: if request.auth != null && request.resource.data.uploaderId == request.auth.uid;
    }

    /**
     * @description: Controls access to chat messages. Allows public read access, but restricts write access to the user who sent the message.
     * @path: /chat_messages/{chatMessageId}
     * @allow: Any user (get, list). User with UID 'user123' (create, update, delete) if they are the sender of the message (userId == 'user123').
     * @deny: User with UID 'user456' (create, update, delete) if they try to modify a message sent by 'user123'.
     * @principle: Public read, owner-only write. Validates user on create, update, and delete.
     */
    match /chat_messages/{chatMessageId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}