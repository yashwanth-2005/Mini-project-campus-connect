
rules_version = '2';

/**
 * Firestore Security Rules for the CampusConnect App
 *
 * This file defines who can read, write, and delete data in our database.
 * Think of it as the bouncer for our database, checking permissions for every request.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // A helper function to check if the current user has the 'faculty' role.
    function isFaculty() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty';
    }

    // A helper function to check if the user is signed in.
    function isSignedIn() {
        return request.auth != null;
    }

    // A helper function to check if the current user is the owner of a document.
    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    /**
     * User Profiles: Controls access to user data.
     * Rule: You can only view and edit your own profile.
     */
    match /users/{userId} {
      // Allow a user to get their own data, but not anyone else's.
      allow get: if isSignedIn() && isOwner(userId);
      // Disallow anyone from getting a list of all users for privacy.
      allow list: if false;
      // Allow a user to create their own profile.
      allow create: if isSignedIn() && isOwner(userId);
      // Allow a user to update their own profile, but they cannot change their own USN directly.
      allow update: if isSignedIn() && isOwner(userId) && request.resource.data.usn == resource.data.usn;
      // Allow a user to delete their own profile.
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * Announcements: Controls access to campus announcements.
     * Rule: Anyone can read, but only authors can write or delete.
     */
    match /announcements/{announcementId} {
      // Anyone can read announcements.
      allow get, list: if true;
      // An announcement can only be created by its author.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Only the original author can update or delete their announcement.
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    /**
     * Events: Controls access to events.
     * Rule: Anyone can read event information.
     */
    match /events/{eventId} {
      // Anyone can read events.
      allow get, list: if true;
      // For now, creating events is restricted. This could be a future feature for admins.
      allow create, update, delete: if false;
    }

    /**
     * Forum Posts: Controls access to the discussion forum.
     * Rule: Anyone can read, anyone logged in can upvote, but only the author can write/delete.
     */
    match /forum_posts/{forumPostId} {
      // Anyone can read forum posts.
      allow get, list: if true;
      // A post must be created by a logged-in user, who is marked as the author.
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Any logged-in user can update a post (e.g., to upvote it).
      allow update: if isSignedIn();
      // Only the original author can delete their post.
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    /**
     * Resources: Controls access to files in the Resource Hub.
     * Rule: Anyone can read, but only the uploader can write or delete.
     */
    match /resources/{resourceId} {
      // Anyone can read the resource metadata.
      allow get, list: if true;
      // A resource must be uploaded by a logged-in user, who is marked as the uploader.
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
      // Only the original uploader can update or delete their resource.
      allow update, delete: if isSignedIn() && resource.data.uploaderId == request.auth.uid;
    }

    /**
     * Chat Messages: Controls access to chatbot messages.
     * Rule: For now, this is restricted as history is stored locally in the user's browser.
     */
    match /chat_messages/{chatMessageId} {
      allow read, write: if false;
    }

    /**
     * USN Change Requests: Manages student requests to change their USN.
     * Rule: Students can create requests, but only faculty can view and manage them.
     */
    match /usn_change_requests/{requestId} {
      // A student can create a request for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only faculty members can list, view, or update (approve/deny) requests.
      allow list, get, update: if isSignedIn() && isFaculty();
      // Only faculty can delete requests.
      allow delete: if isSignedIn() && isFaculty();
    }
  }
}
