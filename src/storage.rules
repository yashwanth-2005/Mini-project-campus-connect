
rules_version = '2';

// These rules define who can upload, download, and delete files from our cloud storage.
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if a user is logged in.
    function isSignedIn() {
      return request.auth != null;
    }
    
    // This is a broad rule that allows any authenticated user to read and write
    // to any location in the storage bucket. This enables a fully collaborative
    // file-sharing experience for the Resource Hub and Placement Repository.
    match /{allPaths=**} {
      // Allow read (download) and write (upload, update, delete) if the user is signed in.
      allow read, write: if isSignedIn();
    }
  }
}
