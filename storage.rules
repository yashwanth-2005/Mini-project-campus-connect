rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read and write access for all users, but only if they are authenticated.
    // This is a basic rule; you'll likely want to refine this for production.
    // For example, you might want to restrict writes to a user's own folder.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
