
rules_version = '2';

// These rules define who can upload, download, and delete files from our cloud storage.
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if a user is logged in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Match any file in the 'resources' folder.
    match /resources/{filePath} {
      // Any authenticated user can read (download) any file.
      allow read: if isSignedIn();
      // A user can only write (upload, update, delete) if they are authenticated.
      // The logic to prevent deleting/editing others' files is in the 'delete' rule below.
      allow write: if isSignedIn();
    }

    // It's good practice to have a default deny-all rule, though not strictly
    // necessary here since the above rule is specific.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
