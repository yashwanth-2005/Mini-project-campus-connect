rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read and write access for all users, including anonymous users.
    // In a production app, you should restrict this to authenticated users.
    // For example: `allow read, write: if request.auth != null;`
    match /{allPaths=**} {
      allow read, write;
    }
  }
}
